PROJECT_NAME="CRAEMS - Centralized Resource Allocation and Event Management System"
API_V1_STR="/api/v1"
SECRET_KEY="craems_super_secret_jwt_key_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Database Configuration
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_DB="craems_db"

# Fallback / Direct Async Connection String
DATABASE_URL="mysql+aiomysql://root:your_password@127.0.0.1:3306/craems_db"
# Fallback SQLite Async Connection String if MySQL is offline during local test
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./craems.db"

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
