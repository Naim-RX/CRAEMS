{
  "name": "craems-root",
  "version": "1.0.0",
  "description": "Centralized Resource Allocation and Event Management System (CRAEMS)",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm run dev --prefix frontend",
    "backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
